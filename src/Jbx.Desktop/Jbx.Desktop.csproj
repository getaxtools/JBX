<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>JBX</AssemblyName>
    <RootNamespace>Jbx.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jbx.Services\Jbx.Services.csproj" />
    <ProjectReference Include="..\Jbx.Platform.Windows\Jbx.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx" GenerateSource="true" ClassName="Jbx.Desktop.Resources.Strings" EmitFormatMethods="true" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="ThirdPartyNotices.txt" Link="Resources\THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jbx.Desktop.Tests" />
  </ItemGroup>
</Project>
