<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Jbx.Desktop.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome">
  <Style Selector="Window">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- The tabs are the title, as in Windows Terminal; Windows windows have no full-screen caption button. -->
  <Style Selector="Panel#PART_TitleTextPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=":is(Control)[(chrome|WindowDecorationProperties.ElementRole)=FullScreenButton]">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="Path.icon">
    <Setter Property="Width" Value="{StaticResource IconSize}" />
    <Setter Property="Height" Value="{StaticResource IconSize}" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="{StaticResource IconStrokeThickness}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.icon.production">
    <Setter Property="Stroke" Value="{DynamicResource ProductionBrush}" />
  </Style>
  <Style Selector="Path.icon.favourite">
    <Setter Property="Stroke" Value="{DynamicResource FavouriteBrush}" />
    <Setter Property="Fill" Value="{DynamicResource FavouriteBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.bodyStrong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.bodyLarge">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
  </Style>
  <Style Selector="TextBlock.problem">
    <Setter Property="Foreground" Value="{DynamicResource StatusProblemBrush}" />
  </Style>
  <Style Selector="TextBlock.production">
    <Setter Property="Foreground" Value="{DynamicResource ProductionBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Border.commandBar">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Button.command">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.command:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.command:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button:disabled Path.icon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Rectangle.commandSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="{StaticResource CommandSeparatorHeight}" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Fill" Value="{DynamicResource StrokeDividerBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.palette">
    <Setter Property="Width" Value="{StaticResource PaletteWidth}" />
    <Setter Property="MaxWidth" Value="{StaticResource PaletteWidth}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="16,56,16,0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
  </Style>
  <Style Selector="Border.keycap">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeControlBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.documentStrip">
    <Setter Property="Padding" Value="8,6,8,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Button.documentTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Button.documentTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.documentTab.current /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.documentTabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.documentTabs > ListBoxItem">
    <Setter Property="MinWidth" Value="{StaticResource TabMinWidth}" />
    <Setter Property="MaxWidth" Value="{StaticResource TabMaxWidth}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.documentTabs > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.documentTabs > ListBoxItem Button.tabClose">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.documentTabs > ListBoxItem:pointerover Button.tabClose, ListBox.documentTabs > ListBoxItem:selected Button.tabClose">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="ToggleButton.option">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.level.error:unchecked">
    <Setter Property="Foreground" Value="{DynamicResource StatusProblemBrush}" />
  </Style>
  <Style Selector="ToggleButton.level.warning:unchecked">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>

  <Style Selector="ListBox.logLines">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="ListBox.logLines > ListBoxItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TextBlock.lineNumber">
    <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeLog}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Padding" Value="0,0,12,0" />
  </Style>
  <Style Selector="controls|LogLineText.logText">
    <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeLog}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="controls|LogLineText.logText.error">
    <Setter Property="Foreground" Value="{DynamicResource StatusProblemBrush}" />
  </Style>
  <Style Selector="controls|LogLineText.logText.warning">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
  </Style>
  <Style Selector="controls|LogLineText.logText.debug">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.chevron">
    <Setter Property="Width" Value="{StaticResource ChevronSize}" />
    <Setter Property="Height" Value="{StaticResource ChevronSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDividerBrush}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="{StaticResource PanePadding}" />
  </Style>
  <Style Selector="Border.productionBanner">
    <Setter Property="Background" Value="{DynamicResource ProductionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ProductionBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,6" />
  </Style>

  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem">
    <Setter Property="MinWidth" Value="{StaticResource TabMinWidth}" />
    <Setter Property="MaxWidth" Value="{StaticResource TabMaxWidth}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceContentBrush}" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem Button.tabClose">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs > ListBoxItem:pointerover Button.tabClose, ListBox.tabs > ListBoxItem:selected Button.tabClose">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.rows > ListBoxItem">
    <Setter Property="MinHeight" Value="{StaticResource RowMinHeight}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
  </Style>
</Styles>
