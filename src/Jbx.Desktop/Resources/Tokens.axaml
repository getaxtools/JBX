  <StreamGeometry x:Key="IconGoTo">M2,8 L11,8 M8,4.5 L11.5,8 L8,11.5 M14,3 L14,13</StreamGeometry>
  <StreamGeometry x:Key="IconExpandAll">M3.5,3 L8,7.5 L12.5,3 M3.5,8.5 L8,13 L12.5,8.5</StreamGeometry>
  <StreamGeometry x:Key="IconCollapseAll">M3.5,7.5 L8,3 L12.5,7.5 M3.5,13 L8,8.5 L12.5,13</StreamGeometry>
  <StreamGeometry x:Key="IconStar">M8,1.5 L10,5.8 L14.6,6.3 L11.2,9.4 L12.1,14 L8,11.7 L3.9,14 L4.8,9.4 L1.4,6.3 L6,5.8 Z</StreamGeometry>
