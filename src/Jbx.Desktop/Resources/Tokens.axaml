  <StreamGeometry x:Key="IconFile">M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5</StreamGeometry>
  <StreamGeometry x:Key="IconSearch">M6.75,2 A4.75,4.75 0 1 1 6.75,11.5 A4.75,4.75 0 1 1 6.75,2 Z M10.2,10.2 L14,14</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M8,2.5 L8,13.5 M2.5,8 L13.5,8</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 11.5,4.4 M12,1.5 L12,4.6 L8.9,4.6</StreamGeometry>
