  <StreamGeometry x:Key="IconOpenExternal">M9,2 L14,2 L14,7 M14,2 L7.5,8.5 M12,10 L12,14 L2,14 L2,4 L6,4</StreamGeometry>
  <StreamGeometry x:Key="IconPane">M1.5,2.5 L14.5,2.5 L14.5,13.5 L1.5,13.5 Z M5.5,2.5 L5.5,13.5</StreamGeometry>
  <StreamGeometry x:Key="IconFilterClear">M2,3 L14,3 L9.5,8.5 L9.5,13 L6.5,11.5 L6.5,8.5 Z</StreamGeometry>
  <StreamGeometry x:Key="IconConfig">M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M5.5,8 L10.5,8 M5.5,10.5 L10.5,10.5</StreamGeometry>
  <StreamGeometry x:Key="IconReachable">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
  <StreamGeometry x:Key="IconNotFound">M8,1.5 A6.5,6.5 0 1 1 8,14.5 A6.5,6.5 0 1 1 8,1.5 Z M3.4,12.6 L12.6,3.4</StreamGeometry>
  <StreamGeometry x:Key="IconDenied">M4.5,7 L11.5,7 L11.5,14 L4.5,14 Z M6,7 L6,5 A2,2 0 0 1 10,5 L10,7</StreamGeometry>
