<Project>
  <!-- dotnet publish src/Jbx.Desktop -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Precompiled: about 10 MB more, warm start to a titled window about 0.6 s instead of 1.5-2 s. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Whole-library trim warnings from YamlDotNet (JBX uses only its parser and document model, not the
         reflection serializer) and Avalonia.DesignerSupport (designer only). JBX's own code stays fully analysed. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <!-- Native symbol files ship inside SkiaSharp and HarfBuzzSharp, and doc files come from the analyser build; a release needs neither. -->
  <Target Name="JbxDropDeveloperFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>
</Project>
