<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:crash="using:Jbx.Desktop.Features.Crash"
        xmlns:res="using:Jbx.Desktop.Resources"
        x:Class="Jbx.Desktop.Features.Crash.CrashWindow"
        x:DataType="crash:CrashViewModel"
        Title="{x:Static res:Strings.Crash_Title}"
        Width="640" Height="520" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="{x:Static res:Strings.Crash_Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Crash_Intro}" TextWrapping="Wrap" Margin="0,8,0,12" />
    <TextBox Grid.Row="2" Text="{Binding Report}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Cascadia Mono, Consolas"
             AutomationProperties.Name="{x:Static res:Strings.Crash_Title}"
             AutomationProperties.AutomationId="Crash.Report" />
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Text="{Binding ActionMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                 AutomationProperties.Name="{Binding ActionMessage}" AutomationProperties.LiveSetting="Polite" />
      <Button Grid.Column="1" Content="{x:Static res:Strings.Crash_Copy}" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="2" Content="{x:Static res:Strings.Crash_Save}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="3" Content="{x:Static res:Strings.Crash_Close}" Command="{Binding CloseCommand}" IsCancel="True" />
    </Grid>
  </Grid>
</Window>
